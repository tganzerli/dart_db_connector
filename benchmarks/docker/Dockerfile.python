# Single-stage build for Python bench (asyncpg).
# Final image ~80MB (python:3.12-slim + asyncpg wheel).

FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        postgresql-client \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY benchmarks/drivers/python/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY benchmarks/drivers/python/ .

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

VOLUME ["/outputs"]

ENTRYPOINT ["python", "/app/main.py"]
CMD ["--workers", "1", "--conns-per-worker", "1", "--tx-count", "5000", "--reps", "3"]
