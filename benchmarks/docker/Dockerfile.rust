# Multi-stage build for Rust bench (tokio-postgres + deadpool).
# Stage 1 (rust:1.83 builder): cargo build --release.
# Stage 2 (debian:stable-slim runtime): only the binary + ca-certs.
# Final image ~30MB.

FROM rust:1.85 AS builder

WORKDIR /src

# Pre-cache deps via dummy build (so cargo registry pulls happen in
# their own layer, surviving src/* edits).
COPY bench/rust/Cargo.toml .
RUN mkdir -p src && echo 'fn main(){}' > src/main.rs \
    && cargo build --release \
    && rm -rf src

COPY bench/rust/src ./src

# Force rebuild of our crate (touch).
RUN touch src/main.rs && cargo build --release

FROM debian:stable-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        postgresql-client \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /src/target/release/bench-rust /app/bench-rust

VOLUME ["/outputs"]

ENTRYPOINT ["/app/bench-rust"]
CMD ["--workers", "1", "--conns-per-worker", "1", "--tx-count", "5000", "--reps", "3"]
