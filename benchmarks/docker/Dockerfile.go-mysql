# Multi-stage build for the Go MySQL bench (go-sql-driver/mysql, ).
# Mirrors Dockerfile.go. go-sql-driver/mysql is pure Go → CGO_ENABLED=0
# static binary; runtime is debian-slim + mysql CLI (for schema apply).

FROM golang:1.23 AS builder

WORKDIR /src
COPY bench/go-mysql/ .
# No go.sum committed; resolve + record checksums, then build statically.
RUN go mod tidy
ENV CGO_ENABLED=0
RUN go build -o /out/bench-go-mysql -ldflags="-s -w" .

FROM debian:stable-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        default-mysql-client \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /out/bench-go-mysql /app/bench-go-mysql

VOLUME ["/outputs"]

ENTRYPOINT ["/app/bench-go-mysql"]
CMD ["--workers", "1", "--conns-per-worker", "1", "--tx-count", "5000", "--reps", "3"]
